{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Without this, prisma.config.ts and prisma/seed.ts at the repo root widen
    // tsc's common source directory and the build lands in dist/src/ instead of
    // dist/ — which breaks `node dist/main`.
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
