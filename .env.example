NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://USER@localhost:5432/transport_management?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
INVITATION_TTL_HOURS=72

# HMAC key for tokenised per-recipient reply addresses and inbound webhook signing
MAIL_TOKEN_SECRET=change-me
INBOUND_WEBHOOK_SECRET=change-me

# Email — "smtp" (Mailpit locally) or "resend" in production
MAIL_TRANSPORT=smtp
MAIL_DOMAIN=mail.example.com
MAIL_FROM_ADDRESS="Transport Platform <no-reply@mail.example.com>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
RESEND_API_KEY=

# Storage — "local" in development, object storage in production
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_FILE_SIZE_BYTES=10485760
MAX_INQUIRY_STORAGE_BYTES=52428800

# Frontend
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Jobs
REMINDER_FIRST_HOURS=24
REMINDER_ESCALATION_HOURS=48
